# Backend environment variables
# Copy this file to .env for local development (never commit .env)
# For production (Render.com), set these in the Render dashboard.

# ── Required ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-prod-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank locally (SQLite is used as fallback).
# On Render this is auto-set from the managed PostgreSQL database.
DATABASE_URL=

# ── App settings ──────────────────────────────────────────────────────────────
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS / CSRF (set to your Netlify URL in production) ───────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
